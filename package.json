{
  "name": "@tredit/ui-library-octaloop",
  "version": "3.8.0",
  "description": "Reusable React UI Library with themes",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "dist/styles.css"
  ],
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "build:js": "tsup",
    "build:types": "tsc --project tsconfig.build.json",
    "build": "npm run build:css && npm run build:js && npm run build:types",
    "prepublishOnly": "npm run build",
    "dev": "vite",
    "start": "vite preview"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.4.19",
    "tsup": "^7.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.2"
  }
}
